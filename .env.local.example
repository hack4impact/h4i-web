# Copy to .env.local. Read before .env by Next.js, Prisma, vitest and the seed.

# Local Postgres from docker-compose.yml (`pnpm db:up`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/volunteer_platform"

# Base URL used in magic-link emails
PUBLIC_URL="http://localhost:3000"

# Magic-link email. Leave empty locally: the link is printed to the dev console.
PLUNK_API_KEY=""

# Needed by the Notion-backed chapters/partners/projects/volunteers pages
NOTION_API_KEY=""

# db:seed / db:deploy refuse non-localhost databases unless "true". Railway sets ALLOW_REMOTE_DEPLOY.
# ALLOW_REMOTE_SEED="false"
# ALLOW_REMOTE_DEPLOY="false"
