generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Permission roles. Cached on User until the ops-api can resolve them at
// sign-in. Directory positions (PM, TL, ...) are a separate enum, not roles.
enum Role {
  NATIONAL_ADMIN
  CHAPTER_LEAD
  PROJECT_LEAD
  MEMBER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? // null for magic-link-only accounts
  role         Role    @default(MEMBER)

  // Volunteer record in the operations-api
  operationsId String? @unique

  // Home chapter; null for Nationals staff and unassigned sign-ups
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects    Project[]
  projectMemberships ProjectTeamMember[]

  sessions        Session[]
  magicLinkTokens MagicLinkToken[]

  sourcedProjects SourcedProject[]
  requestedClaims ProjectClaim[]       @relation("ClaimRequestedBy")
  resolvedClaims  ProjectClaim[]       @relation("ClaimResolvedBy")
  addedLinks      SourcedProjectLink[]

  // Directory profiles this user owns. A user may own both during a
  // member-to-alumni transition; at most one is member-facing visible.
  memberProfile      Member?
  alumniProfile      Alumni?
  adminAuditLogs     AdminAuditLog[]       @relation("AuditActor")
  claimTokensCreated DirectoryClaimToken[] @relation("ClaimTokenCreator")

  @@index([chapterId])
}

// Shared by every chapter-scoped feature. Seeded from prisma/seed/chapters.ts.
model Chapter {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  sourcedProjects  SourcedProject[]
  claims           ProjectClaim[]
  members          Member[]
  alumni           Alumni[]
  hackInvolvements AlumniHackInvolvement[]
  projects         Project[]
}

// One row per signed-in device. id is a random token set by the auth routes.
model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-time sign-in tokens sent by email
model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  userId    String?
  expiresAt DateTime
  usedAt    DateTime? // set on first use
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Sourced Project Exchange
// ---------------------------------------------------------------------------

enum SourcedProjectStatus {
  AVAILABLE
  CLAIM_PENDING
  CLAIMED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum CauseArea {
  HEALTH
  EDUCATION
  FOOD_SECURITY
  HOUSING
  ENVIRONMENT
  ECONOMIC_OPPORTUNITY
  ARTS_AND_CULTURE
  CIVIC_ENGAGEMENT
  OTHER
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
  ABANDONED
}

enum LinkType {
  REPO
  SCOPING_DOC
  DESIGN_FILE
  DELIVERABLE
  OTHER
}

// A vetted but unstaffed nonprofit project posted by its sourcing chapter.
// Client* fields and partnerNotes are gated: they must be stripped server-side
// for roles that are not permitted to see them. Never hard-deleted; use
// withdrawnAt / status instead.
model SourcedProject {
  id                String               @id @default(cuid())
  title             String
  description       String
  scope             String
  causeArea         CauseArea
  techContext       String?
  status            SourcedProjectStatus @default(AVAILABLE)
  handoffNotes      String
  sourcingChapterId String
  sourcedById       String?
  postedAt          DateTime             @default(now())
  lastVerifiedAt    DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  withdrawnAt       DateTime?

  // Gated fields
  clientOrgName      String
  clientContactName  String
  clientContactEmail String
  clientContactPhone String?
  partnerNotes       String?

  sourcingChapter Chapter              @relation(fields: [sourcingChapterId], references: [id], onDelete: Restrict)
  sourcedBy       User?                @relation(fields: [sourcedById], references: [id], onDelete: SetNull)
  claims          ProjectClaim[]
  links           SourcedProjectLink[]

  @@index([status])
  @@index([sourcingChapterId])
  @@index([causeArea])
  @@map("sourced_project")
}

// One claim attempt on a listing. Kept after rejection/abandonment so history
// survives. At most one PENDING or APPROVED claim per listing is enforced by a
// partial unique index in the migration (Prisma can't express it).
model ProjectClaim {
  id                String      @id @default(cuid())
  sourcedProjectId  String
  claimingChapterId String
  requestedById     String
  status            ClaimStatus @default(PENDING)
  message           String?
  requestedAt       DateTime    @default(now())
  resolvedAt        DateTime?
  resolvedById      String?

  sourcedProject  SourcedProject @relation(fields: [sourcedProjectId], references: [id], onDelete: Restrict)
  claimingChapter Chapter        @relation(fields: [claimingChapterId], references: [id], onDelete: Restrict)
  requestedBy     User           @relation("ClaimRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy      User?          @relation("ClaimResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([sourcedProjectId])
  @@index([claimingChapterId])
  @@index([status])
  @@map("project_claim")
}

// Artifact from prior work attached to a listing (repo, scoping doc, etc.).
model SourcedProjectLink {
  id               String   @id @default(cuid())
  sourcedProjectId String
  label            String
  url              String
  linkType         LinkType @default(OTHER)
  addedById        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourcedProject SourcedProject @relation(fields: [sourcedProjectId], references: [id], onDelete: Cascade)
  addedBy        User           @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@index([sourcedProjectId])
  @@map("sourced_project_link")
}

// ---------------------------------------------------------------------------
// Member & Alumni Directory
// ---------------------------------------------------------------------------

enum DirectoryAuditAction {
  PROFILE_APPROVED
  PROFILE_REJECTED
  PROFILE_MANUAL_CREATED
  PROFILE_CLAIMED
  PROFILE_CONSENTED
  MEMBER_TO_ALUMNI_TRANSITIONED
  USER_ROLE_CHANGED
}

enum DirectoryAuditTargetKind {
  MEMBER
  ALUMNI
  USER
}

enum DirectoryClaimProfileKind {
  MEMBER
  ALUMNI
}

// =============================================================================
// Directory organizational positions (PRD: PM, TL, DEVELOPER, DESIGNER, Business).
// Casing follows existing SCREAMING_SNAKE enum convention (Role).
// Mapping from PRD labels:
//   PM        → PM
//   TL        → TL
//   DEVELOPER → DEVELOPER
//   DESIGNER  → DESIGNER
//   Business  → BUSINESS
// AlumniHackInvolvement.roleLabel preserves raw historical labels; `position`
// is set only when the mapping is unambiguous (see src/lib/directory/role-mappings.ts).
// =============================================================================
enum DirectoryPosition {
  PM
  TL
  DEVELOPER
  DESIGNER
  BUSINESS
}

// Profile moderation state — distinct from Role (admin privileges) and from
// ownership / DirectoryPosition. New self-created profiles default to PENDING.
// Backfill decision for any future import of legacy rows: leave as PENDING
// (do not silently approve). Nationals approve via a later workflow.
enum DirectoryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// Member directory profile (current / active members).
// Kept separate from Alumni — do not merge into a single profile table.
//
// Authoritative directory consent lives ONLY here (directoryOptIn). User has no
// directory opt-in field.
//
// Member-facing visibility (authenticated directory — not public web):
//   userId IS NOT NULL
//   AND approvalStatus = APPROVED
//   AND directoryOptIn = true
//   AND adminHidden = false
// Claiming/owning does not approve or opt in. Owner and National Admin
// unpublished access is separate (later authz).
// Unresolved PRD question: may admins edit another person’s profile?
// =============================================================================
model Member {
  id     String  @id @default(cuid())
  // Nullable: unclaimed legacy / admin-created profiles have no owner yet.
  // onDelete SetNull keeps directory history. DB trigger clears directoryOptIn on
  // ANY ownership change (A→B or A→null); same-statement opt-in is overwritten.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  displayName  String?
  // Directory-shared contact — distinct from User.email (private account email).
  contactEmail String?
  linkedInUrl  String?
  githubUrl    String?
  websiteUrl   String?
  instagramUrl String?

  graduationYear Int?
  major          String?
  location       String?
  skills         String[] @default([])
  interests      String[] @default([])
  bio            String?

  // Organizational directory position — not an admin permission (see Role).
  position DirectoryPosition?

  approvalStatus DirectoryApprovalStatus @default(PENDING)
  directoryOptIn Boolean                 @default(false)
  adminHidden    Boolean                 @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@index([approvalStatus, directoryOptIn, adminHidden, userId])
  @@index([graduationYear])
}

// =============================================================================
// Alumni directory profile — separate storage from Member.
// Job experience and Hack involvement history hang off this model.
// =============================================================================
model Alumni {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  displayName  String?
  contactEmail String?
  linkedInUrl  String?
  githubUrl    String?
  websiteUrl   String?
  // PRD: alumni Instagram links supported as shared directory contact.
  instagramUrl String?

  graduationYear Int?
  major          String?
  location       String?
  skills         String[] @default([])
  interests      String[] @default([])
  bio            String?

  // Primary / current directory position when known; historical roles live on
  // AlumniHackInvolvement.
  position DirectoryPosition?

  approvalStatus DirectoryApprovalStatus @default(PENDING)
  directoryOptIn Boolean                 @default(false)
  adminHidden    Boolean                 @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobExperiences   AlumniJobExperience[]
  hackInvolvements AlumniHackInvolvement[]

  @@index([chapterId])
  @@index([approvalStatus, directoryOptIn, adminHidden, userId])
  @@index([graduationYear])
}

model AlumniJobExperience {
  id       String @id @default(cuid())
  alumniId String
  alumni   Alumni @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  company   String?
  title     String?
  location  String?
  startYear Int?
  endYear   Int? // null = current
  isCurrent Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alumniId])
}

// Historical Hack for Impact involvement. roleLabel preserves raw/historical
// wording; position is the canonical DirectoryPosition when mapping is unambiguous.
// Year range fields preserve existing representation (semester labels not stored).
model AlumniHackInvolvement {
  id       String @id @default(cuid())
  alumniId String
  alumni   Alumni @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  roleLabel   String?
  position    DirectoryPosition?
  projectName String?
  startYear   Int?
  endYear     Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alumniId])
  @@index([chapterId])
}

// Append-only admin audit trail for directory moderation and role changes.
model AdminAuditLog {
  id          String                   @id @default(cuid())
  actorUserId String
  actor       User                     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      DirectoryAuditAction
  targetKind  DirectoryAuditTargetKind
  targetId    String
  metadata    Json?
  createdAt   DateTime                 @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// One-time tokens for verified profile claiming (no auto-claim by email/name).
model DirectoryClaimToken {
  id              String                    @id @default(cuid())
  token           String                    @unique
  profileKind     DirectoryClaimProfileKind
  profileId       String
  createdByUserId String
  createdBy       User                      @relation("ClaimTokenCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime                  @default(now())

  @@index([profileKind, profileId])
  @@index([expiresAt])
}

enum ProjectStage {
  design
  development
  launched
  maintenance
}

enum ProjectResourceType {
  Slack
  GitHub
  GoogleDrive
  Other
}

model Project {
  id                    String                @id @default(cuid())
  name                  String
  tagline               String?               @db.VarChar(180)
  chapterId             String                @map("chapter_id")
  chapter               Chapter               @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  stage                 ProjectStage          @default(design)
  techStack             String[]              @default([]) @map("tech_stack")
  causeAreas            String[]              @default([]) @map("cause_areas")
  nonprofitPartnerId    String?               @map("nonprofit_partner_id")
  nonprofitPartnerName  String?               @map("nonprofit_partner_name")
  nonprofitPartnerPhoto String?               @map("nonprofit_partner_photo")
  startDate             DateTime?             @map("start_date") @db.Date
  endDate               DateTime?             @map("end_date") @db.Date
  lastUpdated           DateTime?             @map("last_updated")
  problemStatement      String?               @map("problem_statement")
  goalStatement         String?               @map("goal_statement")
  solutionDescription   String?               @map("solution_description")
  demoMedia             String[]              @default([]) @map("demo_media")
  isDraft               Boolean               @default(true) @map("is_draft")
  // Published columns remain live while partial edits await a successful publish.
  pendingChanges        Json?                 @map("pending_changes")
  createdBy             String                @map("created_by")
  creator               User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  teamMembers           ProjectTeamMember[]
  resourceLinks         ProjectResourceLink[]

  @@index([isDraft, chapterId, stage])
  @@map("projects")
}

model ProjectTeamMember {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  userId    String  @map("user_id")
  role      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId, role])
  @@index([userId])
  @@map("project_team_members")
}

model ProjectResourceLink {
  id        String              @id @default(cuid())
  projectId String              @map("project_id")
  type      ProjectResourceType
  url       String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_resource_links")
}
