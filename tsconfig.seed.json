{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "prisma/seed.ts",
    "prisma/seed-directory.ts",
    "prisma/verify-directory-schema.ts",
    "prisma/manual-directory-fixtures.ts"
  ]
}
